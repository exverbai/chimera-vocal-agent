{
  "description": "chimera-sing: sing the start of each reply in auto mode, carry out /sing, stop the song on a new prompt",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" hook", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" hook", "timeout": 15 }
        ]
      }
    ]
  }
}
