{
  "description": "sing: sing each reply in sing mode, carry out the /sing: commands and the prompts sing on / sing off / sing stop, stop the song on a new prompt",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" hook", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" hook", "timeout": 15 }
        ]
      }
    ]
  }
}
